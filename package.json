{
  "name": "mabriona-studio-desktop",
  "productName": "MABRIONA STUDIO",
  "version": "0.1.0",
  "description": "App de escritorio descargable de MABRIONA STUDIO — motor real (Electron) que carga la plataforma de producción en su propia ventana nativa.",
  "main": "main.js",
  "author": "Wber733",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir",
    "dist:mac:dmg": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --publish=never",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mabriona.studio",
    "productName": "MABRIONA STUDIO",
    "icon": "build/icon.icns",
    "files": ["main.js"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "dmg": {
      "title": "MABRIONA STUDIO",
      "icon": "build/icon.icns",
      "background": null,
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 140, "y": 190, "type": "file" },
        { "x": 400, "y": 190, "type": "link", "path": "/Applications" },
        { "x": 270, "y": 330, "type": "file", "path": "build/Desinstalar MABRIONA STUDIO.command", "name": "Desinstalar MABRIONA STUDIO.command" }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [{ "target": "AppImage", "arch": ["x64"] }]
    },
    "directories": {
      "output": "dist"
    }
  }
}
